# Settings for `pnpm run deploy` (scripts/deploy.mjs).
# Copy this file to .env.deploy and fill in CPANEL_TOKEN. .env.deploy is in .gitignore:
# never commit it, and never paste the token into chat, an issue or a commit.

# cPanel server. The script connects to this IP directly (bekrpardazan.com has no proxy in
# front of it), on cPanel's HTTPS port.
CPANEL_HOST=5.144.129.133
CPANEL_PORT=2083

# Name on cPanel's TLS certificate. The certificate is for the domain, not the IP, so the
# script sends this name to verify it. Change it only if the certificate changes.
CPANEL_SERVERNAME=bekrpardazan.com

# cPanel account name (shown at the top right of cPanel).
CPANEL_USER=bekrpard

# cPanel API token: cPanel -> Security -> Manage API Tokens -> Create.
# It gives full access to the account, so treat it like the cPanel password.
# To revoke it, delete it on the same page and put a new one here.
CPANEL_TOKEN=

# Page fetched after the deploy to check the site answers with 200.
SITE_URL=https://www.bekrpardazan.com/

# Pause between API calls in milliseconds. The host's firewall blocks an IP that sends
# bursts of requests (it blocked this PC once), so don't lower this much.
DEPLOY_PAUSE_MS=1500

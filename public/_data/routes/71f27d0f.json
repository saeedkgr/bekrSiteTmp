</p>","author":{"name":"mehr","path":"/author/hasan/"},"categories":[{"name":"مالی اقتصادی حسابداری","path":"/category/blog/َّaf/"},{"name":"وبلاگ","path":"/category/blog/"}],"tags":[{"name":"عیدی","path":"/tag/عیدی/"},{"name":"عیدی کارگران ۹۹","path":"/tag/عیدی-کارگران-۹۹/"},{"name":"عیدی کارمندان","path":"/tag/عیدی-کارمندان/"},{"name":"قانون کار","path":"/tag/قانون-کار/"},{"name":"کارفرما","path":"/tag/کارفرما/"}],"featured":{"src":"/wp-content/uploads/2020/10/labor.jpg","medium":"/wp-content/uploads/2020/10/labor-768x494.jpg","thumb":"/wp-content/uploads/2020/10/labor-150x150.jpg","alt":"کارگر","width":1000,"height":643},"prev":{"path":"/دستورالعمل-ثبت-چک-در-سامانه-صیاد/","html":"<span class=\"meta-nav\">&larr;</span> دستورالعمل ثبت اطلاعات چک در سامانه صیاد"},"next":{"path":"/مراحل-راه-اندازي-يك-كسب-و-كار-جديد/","html":"&#8220;مراحل راه اندازي يك كسب و كار جديد براي جوانان&#8221; <span class=\"meta-nav\">&rarr;</span>"},"seo":{"title":"محاسبه عیدی کارگران در سال ۹۹ – شرکت بکرپردازان دنیای مجازی","description":""},"slug":"%d9%85%d8%ad%d8%a7%d8%b3%d8%a8%d9%87-%d8%b9%db%8c%d8%af%db%8c-%da%a9%d8%a7%d8%b1%da%af%d8%b1%d8%a7%d9%86-%d8%af%d8%b1-%d8%b3%d8%a7%d9%84-%db%b9%db%b9"}
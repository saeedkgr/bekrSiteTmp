","path":"/author/hasan/"},"categories":[{"name":"مهارت های فردی","path":"/category/مهارت-های-فردی/"},{"name":"وبلاگ","path":"/category/blog/"}],"tags":[{"name":"چگونه نقاط قوت خود را تقویت کنیم","path":"/tag/چگونه-نقاط-قوت-خود-را-تقویت-کنیم/"}],"featured":{"src":"/wp-content/uploads/2020/10/employee-strengths-and-weaknesses.jpg","medium":"/wp-content/uploads/2020/10/employee-strengths-and-weaknesses-768x524.jpg","thumb":"/wp-content/uploads/2020/10/employee-strengths-and-weaknesses-150x150.jpg","alt":"شناسایی نقاط قوت","width":820,"height":560},"prev":{"path":"/تصمیم-گیری-و-هدف-گذاری/","html":"<span class=\"meta-nav\">&larr;</span> تصمیم گیری و هدف گذاری"},"next":{"path":"/چگونه-مالیات-کمتری-پرداخت-کنیم؟/","html":"چگونه مالیات کمتری پرداخت کنیم؟ <span class=\"meta-nav\">&rarr;</span>"},"seo":{"title":"۵ نقطه قوت خود را بشناسید – شرکت بکرپردازان دنیای مجازی","description":""},"slug":"%db%b5-%d9%86%d9%82%d8%b7%d9%87-%d9%82%d9%88%d8%aa-%d8%ae%d9%88%d8%af-%d8%b1%d8%a7-%d8%a8%d8%b4%d9%86%d8%a7%d8%b3%db%8c%d8%af"}